{
  "appId": "com.bravekoon.mathsolver.app",
  "appName": "Math Solver",
  "webDir": "dist",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#faf9f5",
    "limitsNavigationsToAppBoundDomains": false,
    "scrollEnabled": false
  },
  "experimental": {
    "ios": {
      "spm": {
        "swiftToolsVersion": "6.2"
      }
    }
  },
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  }
}
